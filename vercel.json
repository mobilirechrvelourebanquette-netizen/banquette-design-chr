{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {"src": "/webhook/?", "dest": "app.py"},
    {"src": "/webhook/retell/?", "dest": "app.py"},
    {"src": "/retell/trigger/?", "dest": "app.py"},
    {"src": "/internal/worker/?", "dest": "app.py"},
    {"src": "/chat/?", "dest": "app.py"},
    {"src": "/health/?", "dest": "app.py"},
    {"src": "/(.*)", "dest": "app.py"}
  ]
}
